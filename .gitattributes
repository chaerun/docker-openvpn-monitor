# Auto-detect text files and ensure they are normalized to LF (Linux standard)
# This prevents Windows checkouts from breaking Docker container execution.
* text=auto eol=lf

# Explicitly force LF for core execution files
Dockerfile  text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf

# Documentation and web assets
*.md        text eol=lf
*.txt       text eol=lf
*.svg       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf

# Binary files (Git should never touch line endings for these)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.gz        binary
*.tar       binary
*.zip       binary
*.mmdb      binary